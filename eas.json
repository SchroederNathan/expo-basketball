{
  "build": {
    "development": {
      "bun": "1.2.22",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "bun": "1.2.22",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "bun": "1.2.22",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    },
    "agent-preview": {
      "extends": "preview",
      "developmentClient": false,
      "channel": "agent-preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_AGENT_DEMO": "prizepicks-v1"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    }
  }
}
